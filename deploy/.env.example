# 对外微信 H5 域名，须完成 HTTPS 和微信公众平台域名配置。
H5_DOMAIN=h5.example.com
TLS_CERT_DIR=/etc/letsencrypt/live/h5.example.com

# 普通排盘不需要数据库。启用 AI profile 时再填写以下服务端变量。
BAZI_DATABASE_URL=
BAZI_LLM_API_KEY=
BAZI_LLM_BASE_URL=https://api.deepseek.com/v1
BAZI_LLM_MODEL=deepseek-chat
BAZI_ANALYSIS_PROMPT_VERSION=bazi-analysis-1.0.0
BAZI_WORKER_CONCURRENCY=4
BAZI_MAX_RUNNING_SECTIONS_PER_JOB=4
BAZI_ANALYSIS_RETRY_DELAYS_SECONDS=30,60,120

# WeChat service-account OAuth. Keep disabled until the official account and
# callback domain are ready. Never commit a real AppSecret.
BAZI_WECHAT_AUTH_MODE=disabled
BAZI_WECHAT_APP_ID=
BAZI_WECHAT_APP_SECRET=
BAZI_WECHAT_OAUTH_CALLBACK_URL=https://h5.example.com/api/v1/auth/wechat/callback
BAZI_WECHAT_OAUTH_SCOPE=snsapi_base
BAZI_SESSION_COOKIE_SECURE=true
BAZI_AUTH_REQUIRED_FOR_ANALYSIS=false
# 0 means unlimited. Set a positive value before public traffic if desired.
BAZI_USER_ANALYSIS_LIMIT_PER_24H=0
