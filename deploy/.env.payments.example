# Keep real values in the SERVER's /root/bazi-payment-secrets/payment.env.
# Load after deploy/.env.preprod using a second --env-file; never source/print it.
# Keep disabled until all checks in docs/wechat-payments.md are complete.
BAZI_PAY_MODE=disabled
BAZI_PAY_ACCEPT_NEW_ORDERS=false
# Enable only after migrating refund tables and isolated acceptance; independent of purchases.
BAZI_PAY_REFUNDS_ENABLED=false
BAZI_PAY_REFUND_NOTIFY_URL=https://destiny.miaohe.club/api/v1/payments/wechat/refund-notify
BAZI_PAY_MCHID=
# Merchant API certificate serial number; not the website HTTPS certificate.
BAZI_PAY_SERIAL=
BAZI_PAY_PUBLIC_KEY_ID=
BAZI_PAY_API_V3_KEY=
BAZI_PAY_NOTIFY_URL=https://destiny.miaohe.club/api/v1/payments/wechat/notify
# Integer CNY cents; never change prices on an existing order.
BAZI_PAY_SINGLE_PRICE=8800
BAZI_PAY_DOUBLE_PRICE=15800
BAZI_PAY_FAMILY_PRICE=22800
