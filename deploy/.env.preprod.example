# Copy to deploy/.env.preprod. Keep the real file on the server only (chmod 600).
H5_DOMAIN=bazi-staging.example.com
TLS_CERT_DIR=./certs

MYSQL_DATABASE=bazi
MYSQL_USER=bazi
# Use at least 20 URL-safe random characters (letters, digits, _, -, . or ~).
MYSQL_PASSWORD=replace-with-url-safe-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password

# Only the worker receives this value in compose.yaml.
BAZI_LLM_API_KEY=replace-with-real-deepseek-key
BAZI_LLM_BASE_URL=https://api.deepseek.com/v1
BAZI_LLM_MODEL=deepseek-chat
BAZI_ANALYSIS_PROMPT_VERSION=bazi-analysis-1.0.0
BAZI_WORKER_CONCURRENCY=4
BAZI_MAX_RUNNING_SECTIONS_PER_JOB=4
BAZI_ANALYSIS_RETRY_DELAYS_SECONDS=30,60,120
BAZI_LOG_LEVEL=INFO

# WeChat service-account OAuth. While certification is pending, leave disabled
# or use mock only in an isolated local environment (never on public production).
BAZI_WECHAT_AUTH_MODE=disabled
BAZI_WECHAT_APP_ID=
BAZI_WECHAT_APP_SECRET=
BAZI_WECHAT_OAUTH_CALLBACK_URL=https://bazi-staging.example.com/api/v1/auth/wechat/callback
BAZI_WECHAT_OAUTH_SCOPE=snsapi_base
BAZI_SESSION_COOKIE_SECURE=true
BAZI_AUTH_REQUIRED_FOR_ANALYSIS=false
BAZI_USER_ANALYSIS_LIMIT_PER_24H=0

